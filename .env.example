# ============================================================
# Environment variables for the Real-Currents Node.js server
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# ============================================================

# ----- Server -----------------------------------------------
NODE_ENV=production
PORT=3000

# ----- IPFS Worker Node (Phase 1 / Caddy-protected Kubo) ---
# Hostname of the Caddy reverse proxy in front of the IPFS API.
IPFS_NODE_HOST=ipfs-api.real-currents.com

# Basic-auth credentials that Caddy expects.
IPFS_USER=gandi
IPFS_PASS=your-strong-password-here

# ----- Deployment API ---------------------------------------
# Secret shared between GitHub Actions and this server.
# Generate with: openssl rand -hex 32
DEPLOY_SECRET=generate-a-strong-random-secret-here
